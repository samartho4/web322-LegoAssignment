<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User History</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/tailwind.css" />
  </head>
  <body>
    <%- include('partials/navbar', {page:'/userHistory'}) %>

    <div class="container mx-auto p-4">

        <div class="container mx-auto p-4">
            <div class="container mx-auto">
                <div class="hero bg-base-200 rounded-lg p-6">
                    <div class="hero-content text-center ">
                        <div class="max-w-md">
                            <h1 class="text-5xl font-bold">User History</h1>
                            <p class="py-6">User History: <%= session.user.email %></p>
                        </div>
                    </div>
                </div>
            </div>
    

      <div class="overflow-x-auto">
        <table class="table w-full">
          <thead>
            <tr>
              <th>Login Date/Time</th>
              <th>Client Information</th>
            </tr>
          </thead>
          <tbody>
            <% session.user.loginHistory.forEach(function(history) { %> <% if
            (history.userAgent !== 'Unknown') { %>
            <tr>
              <td><%= new Date(history.dateTime) %></td>
              <td><%= history.userAgent %></td>
            </tr>
            <% } %> <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
