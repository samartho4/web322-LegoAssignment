<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <title>Edit Set - <%= set.name %></title>
</head>

<style>
    form{
        width: 400px;
        padding: 20px;
    }
    form div{
        padding: 10px;
        border: 1px solid black;
    }
    form label{
        border: 1px solid blue;
    }
    form input{
        border: 1px solid brown;
    }
</style>

<body>
    <%- include('partials/navbar', {page: ''}) %>

    <div class="container mx-auto p-4">
        <div class="container mx-auto">
            <div class="hero bg-base-200 rounded-lg p-6">
                <div class="hero-content text-center ">
                    <div class="max-w-md">
                        <h1 class="text-5xl font-bold">Edit Set</h1>
                        <p class="py-6">"Edit your set below"</p>
                    </div>
                </div>
            </div>
        </div>

        <form action="/lego/editSet" method="POST">
            <div>
                <label for="name">Name:</label> <br>
                <input type="text" id="name" name="name" value="<%= set.name %>" required>
            </div>
            <div>
                <label for="year">Year:</label> <br>
                <input type="number" id="year" name="year" value="<%= set.year %>" required>
            </div>

            <div>
                <label for="num_parts">Number of Parts:</label> <br>
                <input type="number" id="num_parts" name="num_parts" value="<%= set.num_parts %>" required>
            </div>

            <div>
                <label for="img_url">Image URL:</label> <br>
                <input type="url" id="img_url" name="img_url" value="<%= set.img_url %>" required>
            </div>

            <div>
                <label for="theme_id">Theme:</label> <br>
                <select id="theme_id" name="theme_id" required>
                    <% themes.forEach(theme => { %>
                        <option value="<%= theme.id %>" <%= (set.theme_id == theme.id) ? "selected" : "" %>><%= theme.name %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label for="set_num">Set Number:</label>
                <input type="text" id="set_num" name="set_num" value="<%= set.set_num %>" readonly class="cursor-not-allowed">
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Update Set</button>
                <a href="/lego/deleteSet/<%= set.set_num %>" class="btn btn-info">Delete Set</a>
            </div>
        </form>
    </div>
</body>
</html>
