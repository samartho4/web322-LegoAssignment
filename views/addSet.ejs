<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/tailwind.css">
  <title>Lego Collection</title>
</head>

<style>
    form{
        width: 400px;
        padding: 20px;
    }
    form div{
        padding: 10px;
        border: 1px solid black;
    }
    form label{
        border: 1px solid blue;
    }
    form input{
        border: 1px solid brown;
    }
</style>

<body>
  <%- include('partials/navbar',{page:'/lego/addSet'}) %>

  <div class="container mx-auto">
    <div class="hero bg-base-200 rounded-lg p-6">
        <div class="hero-content text-center ">
            <div class="max-w-md">
                <h1 class="text-5xl font-bold">Add Set</h1>
                <p class="py-6">"Add you set below"</p>
            </div>
        </div>
    </div>
</div>

    <form action="/lego/addSet" method="POST">
        <div>
            <label for="name">Name:</label> <br>
            <input type="text" id="name" name="name" required>
        </div>

        <div>
            <label for="year">Year:</label> <br>
            <input type="number" id="year" name="year" required>
        </div>

        <div>
            <label for="num_parts">Number of Parts:</label> <br>
            <input type="number" id="num_parts" name="num_parts" required>
        </div>

        <div>
            <label for="img_url">Image URL:</label> <br>
            <input type="url" id="img_url" name="img_url" required>
        </div>

        <div>
            <label for="theme_id">Theme:</label> <br>
            <select id="theme_id" name="theme_id" required>
                <% themes.forEach(theme => { %>
                    <option value="<%= theme.id %>"><%= theme.name %></option>
                <% }); %>
            </select>
        </div>

        <div>
            <label for="set_num">Set Number:</label>
            <input type="text" id="set_num" name="set_num" required>
        </div>

        <div>
            <button type="submit" class="btn btn-info">Submit</button>
        </div>
    </form>
    
</body>
</html>