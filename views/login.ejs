<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/tailwind.css">
    <title>Login</title>
</head>
<body>
    <%- include('partials/navbar',{page:'/home'}) %>

    <div class="container mx-auto p-4">
        <div class="container mx-auto">
            <div class="hero bg-base-200 rounded-lg p-6">
                <div class="hero-content text-center ">
                    <div class="max-w-md">
                        <h1 class="text-5xl font-bold">Login</h1>
                        <p class="py-6">Please provide your credentials below</p>
                    </div>
                </div>
            </div>
        </div>

              
        <form action="/login" method="POST" class="p-4 bg-gray-100 rounded">
            <div class="mb-3">
                <label for="userName" class="block text-sm font-medium">User Name</label>
                <input type="text" id="userName" name="userName" placeholder="User Name" required class="w-full p-2 border rounded">
            </div>
            <div class="mb-3">
                <label for="password" class="block text-sm font-medium">Password</label>
                <input type="password" id="password" name="password" placeholder="Password" required class="w-full p-2 border rounded">
            </div>
            <div>
                <button type="submit" class="btn btn-success">Login</button>
            </div>
        </form>        
        
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-error mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span><%= errorMessage %></span>
            </div>
        <% } %>
    </div>
</body>
</html>

